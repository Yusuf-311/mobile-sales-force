# =============================================================================
# Frontend Environment Variables — Mobile Sales Force (MSF)
# =============================================================================
# Copy this file to .env and fill in the values before running the dev server.
# All frontend environment variables MUST use the VITE_ prefix so Vite exposes
# them to client-side code via import.meta.env.
# =============================================================================

# Base URL of the backend API (optional — Vite proxy handles /api/* in dev)
# In production, set this to your deployed backend URL.
VITE_API_URL=http://localhost:3000
